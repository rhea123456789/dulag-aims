# Secrets and local environment
**/.env
**/.env.*
!**/.env.example
mobile/src/environments/environment.local.ts
**/*.pem
**/*.key
**/*.jks
**/*.keystore
**/*.p12
auth.json

# Dependencies
**/node_modules/
**/vendor/

# Generated website and mobile output
**/dist/
**/dist-ssr/
**/www/
**/.angular/
**/out-tsc/
**/tmp/

# Android / Gradle
**/*.apk
**/*.aab
**/*.ap_
**/*.dex
**/local.properties
**/.gradle/
**/android/**/build/
**/captures/
**/.externalNativeBuild/
