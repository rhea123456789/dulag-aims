APP_NAME="Dulag AIMS"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Manila

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_PH

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=dulag_aims
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=log

SANCTUM_STATEFUL_DOMAINS=localhost,localhost:8100,127.0.0.1,127.0.0.1:8100

# Google Gemini is optional and assistive only. Leave the key empty unless you
# have your own key. Do not copy a key from another computer.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_ENABLED=false

# Optional. The API already allows the website and the Capacitor app by default.
# CORS_ALLOWED_ORIGINS=http://localhost:8100,http://localhost:4200,http://localhost,https://localhost,capacitor://localhost
